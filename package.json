{
  "name": "@petercjl/sealseek-media-cli",
  "version": "0.6.8",
  "description": "SealSeek image and video CLI with a portable Skill for Agents with CLI execution; routing is configured by the user in their Agent.",
  "type": "module",
  "bin": {
    "sealseek-media": "bin/sealseek-media.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "capabilities.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/sealseek-media-cli.git"
  },
  "homepage": "https://github.com/petercjl/sealseek-media-cli#readme",
  "bugs": {
    "url": "https://github.com/petercjl/sealseek-media-cli/issues"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/sealseek-media.mjs && node --test",
    "postinstall": "node src/postinstall.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "ajv": "8.20.0",
    "image-size": "^2.0.4"
  }
}
