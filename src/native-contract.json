{
  "source": "https://gateway.sealseek.cn/api/sealseek-infinitecanvas/v3/api-docs",
  "retrieved_at": "2026-10-08",
  "operations": {
    "/canvas/image/quickEditRun": "QuickEditRunParam",
    "/canvas/image/editText": "EditTextParam"
  },
  "schemas": {
    "ImageParams": {
      "type": "object",
      "properties": {
        "num": {
          "type": "string",
          "description": "图片张数",
          "example": "1"
        },
        "resolution": {
          "type": "string",
          "description": "分辨率",
          "example": "1024x1024"
        },
        "aspectRatio": {
          "type": "string",
          "description": "画面比例",
          "example": "1:1"
        },
        "style": {
          "type": "string",
          "description": "风格",
          "example": "realistic"
        },
        "images": {
          "type": "array",
          "description": "参考图列表",
          "items": {
            "type": "string",
            "description": "参考图列表"
          }
        },
        "roles": {
          "type": "array",
          "description": "参考图角色列表，与 images 一一对应（如 quoted、reference、product）",
          "items": {
            "type": "string",
            "description": "参考图角色列表，与 images 一一对应（如 quoted、reference、product）"
          }
        },
        "descriptions": {
          "type": "array",
          "description": "参考图描述列表，与 images 一一对应（主体特征描述，role=product 时有效）",
          "items": {
            "type": "string",
            "description": "参考图描述列表，与 images 一一对应（主体特征描述，role=product 时有效）"
          }
        },
        "model": {
          "type": "string",
          "description": "模型名称（Agent 模式用于传递用户偏好模型，即时覆盖 DB 缓存中的 preferred_image_model）",
          "example": "nano-banana-pro"
        }
      },
      "description": "图片生成参数"
    },
    "VideoParams": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "string",
          "description": "时长（秒）",
          "example": "8"
        },
        "resolution": {
          "type": "string",
          "description": "Resolution tier; validate against the current model catalog.",
          "example": "720p"
        },
        "aspectRatio": {
          "type": "string",
          "description": "画面比例（Seedance 2.0 支持 adaptive）",
          "example": "16:9"
        },
        "motionIntensity": {
          "type": "string",
          "description": "运动幅度",
          "example": "auto"
        },
        "style": {
          "type": "string",
          "description": "风格",
          "example": "general"
        },
        "referenceVideos": {
          "type": "array",
          "description": "参考视频 URL 列表（最多3个，Seedance 2.0）：可用于视频参考、编辑视频、延长/串联视频",
          "items": {
            "type": "string",
            "description": "参考视频 URL 列表（最多3个，Seedance 2.0）：可用于视频参考、编辑视频、延长/串联视频"
          }
        },
        "referenceAudio": {
          "type": "string",
          "description": "参考音频 URL（Seedance 2.0）：克隆音色/音乐旋律/台词内容"
        },
        "referenceAudios": {
          "type": "array",
          "description": "多音频参考 URL 列表（Seedance 2.5 最多 10 段）",
          "items": {
            "type": "string",
            "description": "多音频参考 URL 列表（Seedance 2.5 最多 10 段）"
          }
        },
        "omniReferenceTaskType": {
          "type": "string",
          "description": "任务模式（Seedance 2.5）：reference / edit / extend / auto",
          "example": "reference"
        },
        "outputFormat": {
          "type": "string",
          "description": "输出格式（Seedance 2.5）：mp4 / mov",
          "example": "mp4"
        },
        "generateAudio": {
          "type": "boolean",
          "description": "是否生成音频（Seedance 1.5 Pro；2.0 默认原生输出音频）",
          "example": false
        },
        "videoWebSearch": {
          "type": "boolean",
          "description": "联网搜索增强（Seedance 2.0，仅纯文本输入有效）",
          "example": false
        },
        "model": {
          "type": "string",
          "description": "模型名称（Agent 模式用于传递用户偏好模型，即时覆盖 DB 缓存中的 preferred_video_model）",
          "example": "doubao-seedance-pro"
        },
        "referenceImages": {
          "type": "array",
          "description": "Reference image URLs; limits come from the model catalog.",
          "items": {
            "type": "string",
            "description": "Reference image URL."
          }
        }
      },
      "description": "视频生成参数"
    },
    "QuickEditRunParam": {
      "required": [
        "imageUrl",
        "prompt"
      ],
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "原图 URL"
        },
        "prompt": {
          "type": "string",
          "description": "编辑指令",
          "example": "将背景替换为夜景，保持人物不变"
        },
        "model": {
          "type": "string",
          "description": "Explicit editing model selected by the CLI.",
          "example": "nano-banana-pro",
          "enum": [
            "nano-banana-pro"
          ]
        },
        "canvasId": {
          "type": "string",
          "description": "画布 ID，用于将产物关联到画布任务列表"
        }
      },
      "description": "快捷编辑执行请求参数"
    },
    "EditTextParam": {
      "required": [
        "edits",
        "imageUrl"
      ],
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "原图 OSS URL",
          "example": "https://oss.sealseek.cn/images/example.jpg"
        },
        "edits": {
          "type": "array",
          "description": "文字编辑列表，支持同时编辑多处",
          "items": {
            "$ref": "#/components/schemas/TextEdit"
          }
        },
        "model": {
          "type": "string",
          "description": "Explicit editing model selected by the CLI.",
          "example": "nano-banana-pro",
          "enum": [
            "nano-banana-pro"
          ]
        },
        "canvasId": {
          "type": "string",
          "description": "画布 ID，用于将产物关联到画布任务列表"
        }
      },
      "description": "编辑文字请求参数"
    },
    "TextEdit": {
      "required": [
        "newText",
        "oldText"
      ],
      "type": "object",
      "properties": {
        "oldText": {
          "type": "string",
          "description": "要替换的原始文字",
          "example": "Summer Sale"
        },
        "newText": {
          "type": "string",
          "description": "替换后的新文字",
          "example": "新品上市"
        },
        "x1": {
          "type": "number",
          "description": "文字区域归一化左边界 [0,1]，来自 editTextDetect",
          "format": "double"
        },
        "y1": {
          "type": "number",
          "description": "文字区域归一化上边界 [0,1]",
          "format": "double"
        },
        "x2": {
          "type": "number",
          "description": "文字区域归一化右边界 [0,1]",
          "format": "double"
        },
        "y2": {
          "type": "number",
          "description": "文字区域归一化下边界 [0,1]",
          "format": "double"
        }
      },
      "description": "单条文字编辑项"
    },
    "AssetValidateParam": {
      "required": [
        "assetType",
        "url"
      ],
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "待检测素材的 OSS URL（图片或视频）",
          "example": "https://oss.sealseek.cn/images/avatar.jpg"
        },
        "assetType": {
          "type": "string",
          "description": "素材类型：Image / Video / Audio",
          "example": "Image"
        },
        "name": {
          "type": "string",
          "description": "素材名称，用于管理检索",
          "example": "正面全身照"
        }
      },
      "description": "素材合规检测请求参数"
    }
  },
  "policy": "Schemas narrowed to package model allowlist and exposed inputs."
}
