{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "sealseek-media",
  "target_platforms": [
    "codex",
    "workbuddy",
    "sealseek"
  ],
  "capabilities": [
    {
      "id": "media.generate",
      "purpose": "Generate and retrieve SealSeek media through the calling Agent",
      "required": true,
      "required_features": [
        "host-configured-routing",
        "image",
        "video",
        "reference-image",
        "dry-run",
        "task-record",
        "local-artifact",
        "automatic-video-reference-review",
        "conversation-canvas"
      ],
      "input_fields": [
        "kind",
        "prompt",
        "model",
        "references",
        "parameters",
        "authorization"
      ],
      "output_fields": [
        "task_id",
        "status",
        "artifacts",
        "urls",
        "reference_reviews",
        "canvas_id",
        "canvas_url",
        "canvas_saved",
        "canvas_sync_error"
      ],
      "side_effects": {
        "authorization": "Generation is authorized by the user request; provider routing is configured in the calling Agent.",
        "external_mutation": true,
        "cost": "SealSeek credits for generation",
        "private_state": "Local prompts, task records and account-scoped reference review cache",
        "may_cost_money": true
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "AUTH_REQUIRED",
        "FEATURE_UNSUPPORTED",
        "SUBMISSION_UNCERTAIN",
        "AUTH_EXPIRED",
        "AUTH_REJECTED",
        "ASSET_REVIEW_FAILED",
        "ASSET_REVIEW_INVALID_RESPONSE",
        "ASSET_REVIEW_UNCERTAIN",
        "ASSET_REVIEW_PENDING"
      ]
    },
    {
      "id": "command.execute",
      "purpose": "Execute the installed CLI",
      "required": true,
      "required_features": [
        "node-runtime",
        "structured-output"
      ],
      "input_fields": [
        "command",
        "arguments"
      ],
      "output_fields": [
        "ok",
        "error"
      ],
      "side_effects": {
        "authorization": "Generation is authorized by the user request; provider routing is configured in the calling Agent.",
        "external_mutation": false,
        "cost": "SealSeek credits for generation",
        "private_state": "Local prompts and task records",
        "may_cost_money": false
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "AUTH_REQUIRED",
        "FEATURE_UNSUPPORTED",
        "SUBMISSION_UNCERTAIN",
        "AUTH_EXPIRED",
        "AUTH_REJECTED"
      ]
    },
    {
      "id": "media.authenticate",
      "purpose": "Authorize the current user through the fixed official PLUGIN channel with SMS login",
      "required": false,
      "required_features": [
        "web-login",
        "expiry-status",
        "private-credentials",
        "logout-backup"
      ],
      "input_fields": [
        "human-login-confirmation"
      ],
      "output_fields": [
        "login_id",
        "login_url",
        "status",
        "expires_at"
      ],
      "side_effects": {
        "authorization": "Human explicitly requests login or removal of credentials.",
        "external_mutation": true,
        "may_cost_money": false,
        "private_state": "Managed credential profile and recoverable backups"
      },
      "errors": [
        "AUTH_REQUIRED",
        "AUTH_EXPIRED",
        "AUTH_REJECTED",
        "LOGIN_CONTRACT_FAILED"
      ]
    }
  ],
  "canvas_contract": {
    "version": 1,
    "ownership": {
      "caller": [
        "asset-selection",
        "prompts",
        "workflow",
        "project-state",
        "layout-decisions",
        "business-acceptance"
      ],
      "cli": [
        "explicit-operations",
        "authentication",
        "validation",
        "review",
        "task-recovery",
        "idempotency",
        "verified-writes"
      ]
    },
    "generation_options": {
      "archive": {
        "enum": [
          "canvas",
          "none"
        ],
        "default": "canvas",
        "none_effect": "Skip visible element archival; provider canvas/task history still required."
      },
      "placement": {
        "flag": "--placement JSON_FILE",
        "modes": [
          "append",
          "grid",
          "explicit"
        ],
        "default": {
          "mode": "append",
          "columns": 5,
          "gap": 48,
          "width": 320
        },
        "explicit_positions": "One x/y and optional width/height object per requested output; canvas units.",
        "append_order": "archival-completion then returned-output order",
        "grid_effect": "Explicitly reflow all CLI-owned elements; preserve unrelated positions.",
        "existing_positions_preserved": [
          "append",
          "explicit"
        ]
      }
    },
    "operations": {
      "create": "canvas create --title TEXT --submit",
      "bind": "canvas use ID --session KEY --yes",
      "inspect": "canvas get ID",
      "import": "canvas add ID --media JSON_FILE [--submit]",
      "arrange": "canvas arrange ID [--placement JSON_FILE] --submit",
      "upload": [
        "image upload FILE --submit",
        "video upload FILE --submit"
      ]
    },
    "import_fields": {
      "required": [
        "id",
        "kind",
        "urls"
      ],
      "optional": [
        "ratio",
        "placement",
        "generationParams"
      ],
      "idempotency": "Stable id/output index; changed URL returns IDEMPOTENCY_CONFLICT."
    },
    "placement_limits": {
      "columns": [
        1,
        100
      ],
      "gap": [
        0,
        10000
      ],
      "dimensions": [
        0,
        100000
      ],
      "coordinate_absolute_max": 1000000000
    },
    "suggested_standalone_workflow": "Reuse conversation canvas and append; caller may override.",
    "errors": [
      "INVALID_INPUT",
      "IDEMPOTENCY_CONFLICT",
      "CANVAS_CHANGED",
      "CANVAS_SAVE_UNCERTAIN"
    ]
  }
}
