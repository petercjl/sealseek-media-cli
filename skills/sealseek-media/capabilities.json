{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "sealseek-media",
  "target_platforms": [
    "codex",
    "workbuddy",
    "sealseek",
    "generic"
  ],
  "capabilities": [
    {
      "id": "media.generate",
      "purpose": "Generate and retrieve SealSeek media through the calling Agent",
      "required": true,
      "required_features": [
        "host-configured-routing",
        "image",
        "video",
        "reference-image",
        "dry-run",
        "task-record",
        "local-artifact",
        "automatic-video-reference-review",
        "conversation-canvas"
      ],
      "input_fields": [
        "kind",
        "prompt",
        "model",
        "references",
        "parameters",
        "authorization"
      ],
      "output_fields": [
        "task_id",
        "status",
        "artifacts",
        "urls",
        "reference_reviews",
        "canvas_id",
        "canvas_url",
        "canvas_saved",
        "canvas_sync_error"
      ],
      "side_effects": {
        "authorization": "Generation is authorized by the user request; provider routing is configured in the calling Agent.",
        "external_mutation": true,
        "cost": "SealSeek credits for generation",
        "private_state": "Local prompts, task records and account-scoped reference review cache",
        "may_cost_money": true
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "AUTH_REQUIRED",
        "FEATURE_UNSUPPORTED",
        "SUBMISSION_UNCERTAIN",
        "AUTH_EXPIRED",
        "AUTH_REJECTED",
        "ASSET_REVIEW_FAILED",
        "ASSET_REVIEW_INVALID_RESPONSE",
        "ASSET_REVIEW_UNCERTAIN",
        "ASSET_REVIEW_PENDING"
      ]
    },
    {
      "id": "command.execute",
      "purpose": "Execute the installed CLI",
      "required": true,
      "required_features": [
        "node-runtime",
        "structured-output"
      ],
      "input_fields": [
        "command",
        "arguments"
      ],
      "output_fields": [
        "ok",
        "error"
      ],
      "side_effects": {
        "authorization": "Generation is authorized by the user request; provider routing is configured in the calling Agent.",
        "external_mutation": false,
        "cost": "SealSeek credits for generation",
        "private_state": "Local prompts and task records",
        "may_cost_money": false
      },
      "errors": [
        "CAPABILITY_UNAVAILABLE",
        "AUTH_REQUIRED",
        "FEATURE_UNSUPPORTED",
        "SUBMISSION_UNCERTAIN",
        "AUTH_EXPIRED",
        "AUTH_REJECTED"
      ]
    },
    {
      "id": "media.authenticate",
      "purpose": "Authorize the current user through the fixed official PLUGIN channel with SMS login",
      "required": false,
      "required_features": [
        "web-login",
        "expiry-status",
        "private-credentials",
        "logout-backup"
      ],
      "input_fields": [
        "human-login-confirmation"
      ],
      "output_fields": [
        "login_id",
        "login_url",
        "status",
        "expires_at"
      ],
      "side_effects": {
        "authorization": "Human explicitly requests login or removal of credentials.",
        "external_mutation": true,
        "may_cost_money": false,
        "private_state": "Managed credential profile and recoverable backups"
      },
      "errors": [
        "AUTH_REQUIRED",
        "AUTH_EXPIRED",
        "AUTH_REJECTED",
        "LOGIN_CONTRACT_FAILED"
      ]
    }
  ],
  "canvas_contract": {
    "version": 1,
    "ownership": {
      "caller": [
        "asset-selection",
        "prompts",
        "workflow",
        "project-state",
        "layout-decisions",
        "business-acceptance"
      ],
      "cli": [
        "explicit-operations",
        "authentication",
        "validation",
        "review",
        "task-recovery",
        "idempotency",
        "verified-writes"
      ]
    },
    "generation_options": {
      "archive": {
        "enum": [
          "canvas",
          "none"
        ],
        "default": "canvas",
        "none_effect": "Skip visible element archival; provider canvas/task history still required."
      },
      "placement": {
        "flag": "--placement JSON_FILE",
        "modes": [
          "append",
          "grid",
          "explicit"
        ],
        "default": {
          "mode": "append",
          "columns": 5,
          "gap": 48,
          "width": 320
        },
        "explicit_positions": "One x/y and optional width/height object per requested output; canvas units.",
        "append_order": "archival-completion then returned-output order",
        "grid_effect": "Explicitly reflow all CLI-owned elements; preserve unrelated positions.",
        "existing_positions_preserved": [
          "append",
          "explicit"
        ]
      }
    },
    "operations": {
      "create": "canvas create --title TEXT --submit",
      "bind": "canvas use ID --session KEY --yes",
      "inspect": "canvas get ID",
      "import": "canvas add ID --media JSON_FILE [--submit]",
      "arrange": "canvas arrange ID [--placement JSON_FILE] --submit",
      "upload": [
        "image upload FILE --submit",
        "video upload FILE --submit"
      ],
      "list": "canvas list [--folder FOLDER_ID] [--keyword TEXT]",
      "folders": "canvas folders [--keyword TEXT]",
      "rename": "canvas rename ID --title TEXT [--submit]",
      "move": "canvas move ID (--folder FOLDER_ID | --root) [--submit]",
      "project_list": "project list [--keyword TEXT]",
      "project_create": "project create --name TEXT --request-id KEY [--submit]",
      "project_rename": "project rename ID --name TEXT [--submit]"
    },
    "import_fields": {
      "required": [
        "id",
        "kind",
        "urls"
      ],
      "optional": [
        "ratio",
        "placement",
        "generationParams"
      ],
      "idempotency": "Stable id/output index; changed URL returns IDEMPOTENCY_CONFLICT."
    },
    "placement_limits": {
      "columns": [
        1,
        100
      ],
      "gap": [
        0,
        10000
      ],
      "dimensions": [
        0,
        100000
      ],
      "coordinate_absolute_max": 1000000000
    },
    "suggested_standalone_workflow": "Reuse conversation canvas and append; caller may override.",
    "errors": [
      "INVALID_INPUT",
      "IDEMPOTENCY_CONFLICT",
      "CANVAS_CHANGED",
      "CANVAS_SAVE_UNCERTAIN",
      "FOLDER_NOT_FOUND",
      "CANVAS_UPDATE_UNCERTAIN",
      "PROJECT_UPDATE_UNCERTAIN"
    ],
    "features": [
      "frame-batch",
      "explicit-placement",
      "source-metadata",
      "video-poster",
      "media-inspect",
      "element-placement",
      "text-batch",
      "canvas-rename",
      "canvas-move",
      "folder-discovery",
      "project-create",
      "project-rename"
    ],
    "batch": {
      "command": "canvas batch ID --file JSON_FILE [--submit]",
      "schema": {
        "frames": [
          "id",
          "name",
          "x",
          "y",
          "width",
          "height"
        ],
        "media": "canvas add media entries with frameId and explicit placement",
        "texts": "optional array of id,text,x,y,width,height,fontSize"
      },
      "coordinates": "absolute canvas units",
      "idempotency": "stable frame/media IDs; conflicting bounds or URLs are rejected"
    },
    "element_placement": {
      "command": "canvas place ID --file JSON_FILE [--submit]",
      "input": "array of id,x,y,width,height and optional expected bounds",
      "preserves": "element identity, Frame membership, media URL, metadata",
      "recovery": "query same canvas; repeat same placements; previous bounds checked unless already applied"
    },
    "file_management": {
      "destination": "Existing flat project/folder ID or root; projects and folders share IDs.",
      "preview_default": true,
      "submission_flag": "--submit",
      "backup": "Private metadata and content before mutation; backup path returned.",
      "verification": "Read back title, folder ownership and unchanged content.",
      "idempotency": "Already-applied title or destination returns changed:false without mutation.",
      "preserves": [
        "canvas-id",
        "conversation-binding",
        "content"
      ],
      "recovery": "Inspect the same canvas after uncertain outcomes; no automatic replay."
    },
    "project_management": {
      "name_length": [
        1,
        20
      ],
      "preview_default": true,
      "create_request_id": "Required stable 1-100 ASCII letters/digits/underscore/hyphen, account-scoped.",
      "create_recovery": "Intent before POST; remote ID before readback; reuse ID/name without another POST; unresolved creation blocks replay.",
      "rename_recovery": "Private metadata backup and verified readback by the same folder ID.",
      "preserves": [
        "project-id-on-rename",
        "canvas-membership",
        "conversation-binding"
      ],
      "side_effects": "Creates a project or changes its name; no media generation or automatic canvas move."
    }
  },
  "host_resolution": {
    "named_adapters": [
      "codex",
      "workbuddy",
      "sealseek"
    ],
    "fallback_adapter": "generic",
    "requirements": "Node.js >=22, CLI execution, structured JSON and delivery-file access; verify in the current host.",
    "installation": "Other Agents resolve their own Skill directory and pass --path. Names are adapter preferences, not a host allowlist."
  }
}
